// Generated by Inkwright from the game's notes. Do not edit; regenerate.

LIST characters = walker
VAR character = walker

// Skills of the current character (loaded by pick_character)
VAR might = 0
VAR wits = 0

// Resources
VAR life = 6
VAR gold = 10

// Items: what the character carries (`~ inv += dagger`, `{inv ? dagger: …}`)
LIST items = dagger, spear, cloak, antidote
VAR inv = ()

// Dice: the engine sets these; saved with the state, so back/load/replay roll the same
VAR dice_seed = 0
VAR dice_rolls = 0

// Text in the story's language: {t("zh…", "en…")}; the play panel switches lang.
VAR lang = "zh"

=== function t(zh, en) ===
{ lang == "en":
    ~ return en
}
~ return zh

EXTERNAL check(skill, difficulty)

// Loads a character's preset by id: pick_character("walker")
=== function pick_character(who) ===
{ who == "walker":
    ~ character = walker
    ~ might = 1
    ~ wits = 1
    ~ inv = (dagger, antidote)
    ~ antidote_n = 1
    ~ equipped = (dagger)
    ~ statuses = ""
}

// A skill's current level, by name.
=== function skill_level(skill) ===
{ skill == "might":
    ~ return might
}
{ skill == "wits":
    ~ return wits
}
~ return 0

// Without the engine there are no dice or modifiers: the average roll (7) decides.
=== function check(skill, difficulty) ===
{ skill_level(skill) + 7 >= difficulty:
    ~ return 3
}
~ return 1

// Dice outside a check: {roll("2d6+3")} → the total.
EXTERNAL roll_dice(formula, label)

=== function roll(formula) ===
~ return roll_dice(formula, "")

// Without the engine the dice are flat: each table's average, 1 for anything else.
=== function roll_dice(formula, label) ===
~ return 1

// A choice tagged #use is taken with something carried, written into played first: { played == dagger: … }.
VAR played = ()

// Stacking items: give(antidote, 3), take(antidote, 1) (gives back how many it took), inv_count(antidote).
// An item is in inv while its count is above 0, so {inv ? antidote: …} still works.
VAR antidote_n = 0
=== function give(item_id, amount) ===
{ amount <= 0:
    ~ return
}
{ item_id == antidote:
    ~ antidote_n = antidote_n + amount
}
~ inv += item_id
=== function take(item_id, amount) ===
~ temp taken = 0
{ amount <= 0:
    ~ return 0
}
{ item_id == antidote:
    ~ taken = MIN(amount, antidote_n)
    ~ antidote_n = antidote_n - taken
    { antidote_n <= 0:
        ~ inv -= antidote
    }
    ~ return taken
}
{ inv ? item_id:
    ~ inv -= item_id
    ~ return 1
}
~ return 0
=== function inv_count(item_id) ===
{ item_id == antidote:
    ~ return antidote_n
}
{ inv ? item_id:
    ~ return 1
}
~ return 0

// Equipment: equip(item) wears it (taking off the other item of its slot), unequip(item); {equipped ? item: …}.
// An item with a slot gives its modifiers only while equipped.
VAR equipped = ()
=== function equip(item_id) ===
{ (dagger, spear) ? item_id:
    ~ equipped -= (dagger, spear)
}
{ (cloak) ? item_id:
    ~ equipped -= (cloak)
}
~ inv += item_id
~ equipped += item_id
=== function unequip(item_id) ===
~ equipped -= item_id

// Statuses: add_status(who, "poison", 3) (turns; 0 = until cleared), has_status(who, "poison"), status_turns(who, "poison"),
// clear_status(who, "poison") ("" = all of who's), tick_statuses() (a turn passes), rest_statuses() (statuses marked rest end).
// who is an entity or party member id, or "me" for the character.
VAR statuses = ""
EXTERNAL status_put(status_store, who, status_id, turns)
EXTERNAL status_in(status_store, who, status_id)
EXTERNAL status_left(status_store, who, status_id)
EXTERNAL status_take(status_store, who, status_id)
EXTERNAL status_tick(status_store)
EXTERNAL status_rest(status_store)

// Without the engine nothing takes hold: no one has a status.
=== function status_put(status_store, who, status_id, turns) ===
~ return status_store
=== function status_in(status_store, who, status_id) ===
~ return false
=== function status_left(status_store, who, status_id) ===
~ return 0
=== function status_take(status_store, who, status_id) ===
~ return status_store
=== function status_tick(status_store) ===
~ return status_store
=== function status_rest(status_store) ===
~ return status_store

=== function add_status(who, status_id, turns) ===
~ statuses = status_put(statuses, who, status_id, turns)
=== function has_status(who, status_id) ===
~ return status_in(statuses, who, status_id)
=== function status_turns(who, status_id) ===
~ return status_left(statuses, who, status_id)
=== function clear_status(who, status_id) ===
~ statuses = status_take(statuses, who, status_id)
=== function tick_statuses() ===
~ statuses = status_tick(statuses)
=== function rest_statuses() ===
~ statuses = status_rest(statuses)
