{ ent_has(foe, who_id):
    ~ foe = ent_set(foe, who_id, stat_id, amount, "life")
    { not ent_has(foe, who_id):
        ~ clear_status(who_id, "")
    }
    ~ return
}

=== function add_stat(who_id, stat_id, amount) ===
~ set_stat(who_id, stat_id, stat(who_id, stat_id) + amount)

=== function despawn(who_id) ===
{ who_id == "elder":
    ~ return
}
{ who_id == "middle":
    ~ return
}
{ who_id == "youngest":
    ~ return
}
{ ent_has(foe, who_id):
    ~ foe = ent_drop(foe, who_id)
    ~ clear_status(who_id, "")
    ~ return
}

=== function alive(kind) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { life_elder > 0:
        ~ pick_no = pick_no + 1
    }
    { life_middle > 0:
        ~ pick_no = pick_no + 1
    }
    { life_youngest > 0:
        ~ pick_no = pick_no + 1
    }
    ~ return pick_no
}
{ kind == "foe":
    ~ return ent_count(foe)
}
~ return 0

=== function pick_one(kind, how) ===
~ temp pick_no = 0
~ temp new_id = ""
{ kind == "party":
    ~ pick_no = 0
    { life_elder > 0:
        ~ pick_no = pick_no + 1
    }
    { life_middle > 0:
        ~ pick_no = pick_no + 1
    }
    { life_youngest > 0:
        ~ pick_no = pick_no + 1
    }
    { pick_no <= 0:
        ~ return ""
    }
    { how == "lowest:life":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or life_elder < stat(new_id, "life")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or life_middle < stat(new_id, "life")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or life_youngest < stat(new_id, "life")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "lowest:life_max":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or life_max_elder < stat(new_id, "life_max")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or life_max_middle < stat(new_id, "life_max")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or life_max_youngest < stat(new_id, "life_max")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "lowest:might":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or might_elder < stat(new_id, "might")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or might_middle < stat(new_id, "might")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or might_youngest < stat(new_id, "might")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "lowest:guard":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or guard_elder < stat(new_id, "guard")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or guard_middle < stat(new_id, "guard")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or guard_youngest < stat(new_id, "guard")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "highest:life":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or life_elder > stat(new_id, "life")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or life_middle > stat(new_id, "life")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or life_youngest > stat(new_id, "life")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "highest:life_max":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or life_max_elder > stat(new_id, "life_max")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or life_max_middle > stat(new_id, "life_max")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or life_max_youngest > stat(new_id, "life_max")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "highest:might":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or might_elder > stat(new_id, "might")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or might_middle > stat(new_id, "might")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or might_youngest > stat(new_id, "might")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    { how == "highest:guard":
        ~ new_id = ""
        { life_elder > 0 and (new_id == "" or guard_elder > stat(new_id, "guard")):
            ~ new_id = "elder"
        }
        { life_middle > 0 and (new_id == "" or guard_middle > stat(new_id, "guard")):
            ~ new_id = "middle"
        }
        { life_youngest > 0 and (new_id == "" or guard_youngest > stat(new_id, "guard")):
            ~ new_id = "youngest"
        }
        ~ return new_id
    }
    {
    - how == "first" or pick_no == 1:
        ~ pick_no = 1
    - how == "last":
        ~ pick_no = pick_no
    - how == "random":
        ~ pick_no = roll_dice("1d" + pick_no, "pick:party")
    - else:
        ~ pick_no = 0
    }
    ~ return nth_one(kind, pick_no)
}
{ kind == "foe":
    { how == "random":
        ~ pick_no = ent_count(foe)
        { pick_no <= 0:
            ~ return ""
        }
        { pick_no == 1:
            ~ return ent_at(foe, 1)
        }
        ~ return ent_at(foe, roll_dice("1d" + pick_no, "pick:foe"))
    }
    ~ return ent_pick(foe, how)
}
~ return ""

=== function nth_one(kind, amount) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { life_elder > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "elder"
        }
    }
    { life_middle > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "middle"
        }
    }
    { life_youngest > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "youngest"
        }
    }
    ~ return ""
}
{ kind == "foe":
    ~ return ent_at(foe, amount)
}
~ return ""

=== function name_of(who_id) ===
{ who_id == "elder":
    ~ return t("大哥", "Eldest")
}
{ who_id == "middle":
    ~ return t("二姐", "Middle")
}
{ who_id == "youngest":
    ~ return t("小妹", "Youngest")
}
{ ent_has(foe, who_id):
    ~ return ent_name(foe, "foe", who_id)
}
~ return who_id

// Table rows that spawn: ~ temp row_no = spawn_from("shallow") spawns what the roll's row says and gives the total ({table_text("shallow", row_no)} tells it).
=== function spawn_from(name) ===
~ temp row_no = table_roll(name)
~ spawn_row(name, row_no)
~ return row_no

=== function spawn_row(name, total) ===
{ name == "shallow" and total <= 2:
    ~ return spawn_times(name, total, roll("d3+1"))
}
{ name == "shallow" and total <= 4:
    ~ return spawn_times(name, total, roll("d2+1"))
}
{ name == "shallow" and total <= 5:
    ~ return spawn_times(name, total, 2)
}
{ name == "shallow":
    ~ return spawn_times(name, total, 2)
}
{ name == "deep" and total <= 2:
    ~ return spawn_times(name, total, roll("d2+1"))
}
{ name == "deep" and total <= 3:
    ~ return spawn_times(name, total, 2)
}
{ name == "deep" and total <= 4:
    ~ return spawn_times(name, total, 1)
}
{ name == "deep" and total <= 5:
    ~ return spawn_times(name, total, 1)
}
{ name == "deep":
    ~ return spawn_times(name, total, 1)
}
~ return 0

=== function spawn_row_one(name, total) ===
~ temp new_id = ""
{ name == "shallow" and total <= 2:
    ~ new_id = spawn("foe", "rat")
    ~ return new_id
}
{ name == "shallow" and total <= 4:
    ~ new_id = spawn("foe", "goblin")
    ~ return new_id
}
{ name == "shallow" and total <= 5:
    ~ new_id = spawn("foe", "skeleton")
    ~ return new_id
}
{ name == "shallow":
    ~ new_id = spawn("foe", "spider")
    ~ return new_id
}
{ name == "deep" and total <= 2:
    ~ new_id = spawn("foe", "skeleton")
    ~ return new_id
}
{ name == "deep" and total <= 3:
    ~ new_id = spawn("foe", "cultist")
    ~ return new_id
}
{ name == "deep" and total <= 4:
    ~ new_id = spawn("foe", "ghoul")
    ~ return new_id
}
{ name == "deep" and total <= 5:
    ~ new_id = spawn("foe", "ogre")
    ~ return new_id
}
{ name == "deep":
    ~ new_id = spawn("foe", "wraith")
    ~ return new_id
}
~ return ""

=== function spawn_times(name, total, amount) ===
{ amount <= 0:
    ~ return 0
}
~ spawn_row_one(name, total)
~ return 1 + spawn_times(name, total, amount - 1)
