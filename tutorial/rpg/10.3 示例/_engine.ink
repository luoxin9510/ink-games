    }
    { stat_id == "life_max":
        ~ return life_max_youngest
    }
    { stat_id == "might":
        ~ return might_youngest
    }
    { stat_id == "guard":
        ~ return guard_youngest
    }
    ~ return 0
}
{ ent_has(foe, who_id):
    ~ return ent_get(foe, who_id, stat_id)
}
~ return 0

=== function set_stat(who_id, stat_id, amount) ===
{ who_id == "elder":
    { stat_id == "life":
        ~ life_elder = amount
    }
    { stat_id == "life_max":
