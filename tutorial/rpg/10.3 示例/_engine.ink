    }
    ~ return 0
}
{ who_id == "middle":
    { stat_id == "life":
        ~ return life_middle
    }
    { stat_id == "life_max":
        ~ return life_max_middle
    }
    { stat_id == "might":
        ~ return might_middle
    }
    { stat_id == "guard":
        ~ return guard_middle
    }
    ~ return 0
}
{ who_id == "youngest":
    { stat_id == "life":
