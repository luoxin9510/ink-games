// Generated by Inkwright from the game's notes. Do not edit; regenerate.
INCLUDE ../../../systems/dungeon-crawl/rules.ink

LIST characters = crew
VAR character = crew

// Skills of the current character (loaded by pick_character)
VAR wits = 0

// Resources
VAR torches = 4
VAR potions = 2
VAR gold = 0

// Items: what the character carries (`~ inv += arrow`, `{inv ? arrow: …}`)
LIST items = arrow
VAR inv = ()

// Dice: the engine sets these; saved with the state, so back/load/replay roll the same
VAR dice_seed = 0
VAR dice_rolls = 0

// Text in the story's language: {t("zh…", "en…")}; the play panel switches lang.
VAR lang = "zh"

=== function t(zh, en) ===
{ lang == "en":
    ~ return en
}
~ return zh

// Party: life_elder is a member's life, title_elder a line the panel shows under the name, gear_elder its gear (`~ gear_elder += arrow`).
VAR life_elder = 7
VAR life_max_elder = 7
VAR might_elder = 2
VAR guard_elder = 1
VAR title_elder = ""
VAR gear_elder = ()
VAR life_middle = 6
VAR life_max_middle = 6
VAR might_middle = 2
VAR guard_middle = 1
VAR title_middle = ""
VAR gear_middle = ()
VAR life_youngest = 5
VAR life_max_youngest = 5
VAR might_youngest = 1
VAR guard_youngest = 1
VAR title_youngest = ""
VAR gear_youngest = ()

// member_get(1, "life") or member_get("elder", …) reads <var>_<member> (any variable the story declares per member too); party_count("<var>", value) counts the members whose variable equals value. Done by the engine: far cheaper than a switch in ink.
EXTERNAL member_get(member, var_name)
EXTERNAL party_count(var_name, match)
=== function member_get(member, var_name) ===
{ member == 1 or member == "elder":
    { var_name == "life":
        ~ return life_elder
    }
    { var_name == "life_max":
        ~ return life_max_elder
    }
    { var_name == "might":
        ~ return might_elder
    }
    { var_name == "guard":
        ~ return guard_elder
    }
    { var_name == "title":
        ~ return title_elder
    }
    { var_name == "gear":
        ~ return gear_elder
    }
    ~ return 0
}
{ member == 2 or member == "middle":
    { var_name == "life":
        ~ return life_middle
    }
    { var_name == "life_max":
        ~ return life_max_middle
    }
    { var_name == "might":
        ~ return might_middle
    }
    { var_name == "guard":
        ~ return guard_middle
    }
    { var_name == "title":
        ~ return title_middle
    }
    { var_name == "gear":
        ~ return gear_middle
    }
    ~ return 0
}
{ member == 3 or member == "youngest":
    { var_name == "life":
        ~ return life_youngest
    }
    { var_name == "life_max":
        ~ return life_max_youngest
    }
    { var_name == "might":
        ~ return might_youngest
    }
    { var_name == "guard":
        ~ return guard_youngest
    }
    { var_name == "title":
        ~ return title_youngest
    }
    { var_name == "gear":
        ~ return gear_youngest
    }
    ~ return 0
}
{ var_name == "title":
    ~ return ""
}
{ var_name == "gear":
    ~ return ()
}
~ return 0

