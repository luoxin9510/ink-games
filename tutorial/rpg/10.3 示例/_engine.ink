EXTERNAL check(skill, difficulty)

// Loads a character's preset by id: pick_character("crew")
=== function pick_character(who) ===
{ who == "crew":
    ~ character = crew
    ~ wits = 0
    ~ inv = (arrow)
    ~ arrow_n = 12
    ~ statuses = ""
}

// A skill's current level, by name.
=== function skill_level(skill) ===
{ skill == "wits":
    ~ return wits
}
~ return 0

// Without the engine there are no dice or modifiers: the average roll (7) decides.
=== function check(skill, difficulty) ===
{ skill_level(skill) + 7 >= difficulty:
    ~ return 3
}
~ return 1

// Dice outside a check: {roll("2d6+3")} → the total.
EXTERNAL roll_dice(formula, label)

=== function roll(formula) ===
~ return roll_dice(formula, "")

// Without the engine the dice are flat: each table's average, 1 for anything else.
=== function roll_dice(formula, label) ===
{ formula == "1d6":
    ~ return 4
}
~ return 1

// Tables: {table("rooms")} rolls and reads a row; table_roll(name) is the total alone, table_text/table_id(name, total) look a total up.
=== function table_roll(name) ===
{ name == "rooms":
    ~ return roll_dice("1d6", "rooms")
}
{ name == "shallow":
    ~ return roll_dice("1d6", "shallow")
}
{ name == "deep":
    ~ return roll_dice("1d6", "deep")
}
~ return 0
EXTERNAL table_text(name, total)
EXTERNAL table_id(name, total)

